{
  "name": "concurrent-booking",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:api": "powershell -ExecutionPolicy Bypass -File scripts/test-api.ps1",
    "dev": "tsoa routes --configuration tsoa.json && ts-node-dev --files --respawn src/main.ts",
    "worker:dev": "ts-node-dev --respawn src/worker/reservationExpiryWorker.ts",
    "build": "tsoa routes --configuration tsoa.json && tsc",
    "openapi": "tsoa spec --configuration tsoa.json",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/lib/database.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/lib/database.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker/reservationExpiryWorker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsoa": "7.0.0-alpha.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
